POSTGRES_DB=testclaw
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://postgres:change-me@db:5432/testclaw
REDIS_URL=redis://redis:6379/0
PREFLIGHT_WORKER_TIMEOUT_SECONDS=0.5
FERNET_KEY=generate-with-python-cryptography-fernet
SECRET_KEY=replace-with-long-random-secret
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace-before-production
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://testclaw.oceancute.cn,https://testclaw.oceancute.cn
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=testclaw
DEFAULT_OPENAI_API_KEY=
DEFAULT_OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL_CODER=gpt-4o
DEFAULT_MODEL_VISION=gpt-4o
DEFAULT_MODEL_PLANNER=gpt-4o
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
SANDBOX_TIMEOUT=120
MAX_RETRY_COUNT=3
ACCESS_TOKEN_EXPIRE_MINUTES=60
VITE_API_BASE_URL=/api/v1

# Only used when starting the optional Compose nginx edge proxy:
# docker compose --profile edge up -d nginx
HTTP_PORT=80

# Optional Aliyun OSS screenshot storage. Credentials are read by the official
# SDK from OSS_ACCESS_KEY_ID / OSS_ACCESS_KEY_SECRET.
OSS_ENABLED=false
OSS_BUCKET=
OSS_REGION=cn-hangzhou
OSS_ENDPOINT=
OSS_PUBLIC_BASE_URL=
OSS_PREFIX=testclaw/screenshots
OSS_USE_CNAME=false
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
